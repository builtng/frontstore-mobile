{
  "expo": {
    "name": "FrontStore",
    "slug": "front-store",
    "newArchEnabled": true,
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "frontstore",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07261C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.frontstore.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow FrontStore to access your photos to add product images.",
        "NSPhotoLibraryAddUsageDescription": "Allow FrontStore to save QR codes and images to your photo library.",
        "NSCameraUsageDescription": "Allow FrontStore to access your camera to capture product photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07261C"
      },
      "package": "app.frontstore.mobile",
      "versionCode": 7,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FrontStore to access your photos.",
          "cameraPermission": "Allow FrontStore to use your camera."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow FrontStore to save QR codes to your photo library.",
          "savePhotosPermission": "Allow FrontStore to save QR codes to your photo library.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-video",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0eb8a437-3228-410d-8012-65751488977e"
      }
    },
    "owner": "built-different-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0eb8a437-3228-410d-8012-65751488977e"
    }
  }
}
